[user]
	name = Michael Steinert
	email = msteinert@drwholdings.com
[alias]
	co = checkout
	root = rev-parse --show-toplevel
[core]
	excludesfile = ~/.cvsignore
	autocrlf = input
[push]
	default = current
[pull]
	ff = only
[credential]
	helper = osxkeychain
[fetch]
	prune = true
[http]
	cookiefile = ~/.gitcookies
[diff "lockb"]
	textconv = bun
	binary = true
[init]
	defaultBranch = main
[includeIf "gitdir:~/"]
	path = ~/.gitconfig.local
