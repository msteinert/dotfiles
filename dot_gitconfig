[user]
	name = Michael Steinert
	email = msteinert@drwholdings.com
	#email = mike.steinert@gmail.com
[alias]
	co = checkout
	st = status -s
	lol = log --graph --decorate --pretty=oneline --abbrev-commit
	lola = log --graph --decorate --pretty=oneline --abbrev-commit --all
	root = rev-parse --show-toplevel
	difft = -c diff.external=difft diff
[color]
	diff = auto
	status = auto
	branch = auto
[core]
	excludesfile = ~/.cvsignore
	pager = less -r
	autocrlf = input
[push]
	default = current
[pull]
	ff = only
[credential]
	helper = cache --timeout=86400
[fetch]
	prune = true
[http]
	cookiefile = /Users/msteinert/.gitcookies
[diff "lockb"]
	textconv = bun
	binary = true
[init]
	defaultBranch = main
