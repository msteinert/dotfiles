[user]
	name = Michael Steinert
	email = msteinert@drwholdings.com
[alias]
	co = checkout
	root = rev-parse --show-toplevel
	difft = "!GIT_EXTERNAL_DIFF=difft git diff"
[core]
	excludesfile = ~/.config/gitignore_global
	autocrlf = input
	pager = delta
[push]
	default = current
[pull]
	ff = only
[credential]
	helper = osxkeychain
[fetch]
	prune = true
[http]
	cookiefile = ~/.gitcookies
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
	syntax-theme = zenburn
[diff]
	colorMoved = default
[diff "lockb"]
	textconv = bun
	binary = true
[merge]
	conflictstyle = diff3
[init]
	defaultBranch = main
[includeIf "gitdir:~/"]
	path = ~/.gitconfig.local
