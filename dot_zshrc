# If not running interactively, don't do anything
[[ $- != *i* ]] && return

# Set locale
export LANG=en_US.UTF-8

# Configure history
HISTFILE=$HOME/.histfile
HISTSIZE=10000
SAVEHIST=20000

setopt appendhistory
setopt extendedglob
setopt hist_reduce_blanks
setopt hist_verify
setopt histignorealldups
setopt inc_append_history
setopt no_case_glob
setopt sharehistory

unsetopt beep nomatch

# Function path
fpath=(
    $HOME/.zsh.d/site-functions
    $fpath
)
autoload -Uz compinit
compinit -u

# Path
BREW_PREFIX=/opt/homebrew

path=(
    $HOME/.local/bin
    $HOME/go/bin
    $HOME/.cargo/bin
    $BREW_PREFIX/opt/coreutils/libexec/gnubin
    $BREW_PREFIX/opt/curl/bin
    $path
)
typeset -U path

# Configure GNU ls colors
eval $(dircolors -b $HOME/.dircolors)

# Case insensitive completion for cd etc *N*
zstyle ':completion:*' completer _expand _complete _match
zstyle ':completion:*' completions 0
zstyle ':completion:*' glob 0
zstyle ':completion:*' group-name ''
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' max-errors 1 numeric
zstyle ':completion:*' substitute 0
zstyle :compinstall filename "$HOME/.zshrc"

# Vi command line editing
autoload -U edit-command-line
zle -N edit-command-line
bindkey -v
bindkey '\e[3~' delete-char
bindkey '^r' history-incremental-search-backward
vi-cmd-mode() {
    zle -K vicmd
}
zle -N vi-cmd-mode
bindkey -M vicmd 'v' edit-command-line

# Enable color
autoload -U colors && colors

# Configure the prompt
setopt prompt_subst
PS1='%{$fg[green]%}%n%{$reset_color%}@%{$fg[yellow]%}%m%{$reset_color%} '

# Source definitions
if [[ -d $HOME/.zsh.d ]]; then
    for i in $HOME/.zsh.d/zsh-*; do
        test -r $i && . $i
    done
    unset i
fi

alias ls="ls --color=auto -F"
alias grep="grep --color=auto"
alias fgrep="fgrep --color=auto"
alias egrep="egrep --color=auto"

# Editor settings
export EDITOR="vim"
export INPUTRC="$HOME/.inputrc"

# fzf
export FZF_DEFAULT_COMMAND="fd --type file"
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"

# jq
export JQ_COLORS="0;37:0;39:0;39:0;39:0;32:1;39:1;39"

# rg
export RIPGREP_CONFIG_PATH=$HOME/.ripgreprc

# Zoxide
eval "$(zoxide init zsh)"

# direnv
eval "$(direnv hook zsh)"

export AWS_CONFIG_FILE=$HOME/.drw_cca/aws.config
export cred_proc_CERT_PASSPHRASE="$(security find-generic-password -a "$USER" -s "drwcca-cert-passphrase" -w 2>/dev/null)"
export cred_proc_CERT_BUNDLE=$HOME/.drw_cca/$USER.pfx
export cred_proc_CACHE=True
export cred_proc_TTL=3600

# AI keys
if [[ -d $HOME/.ai ]]; then
    for i in $HOME/.ai/*.sh; do
        test -r $i && . $i
    done
    unset i
fi

# Added by LM Studio CLI (lms)
export PATH="$PATH:$HOME/.lmstudio/bin"
# End of LM Studio CLI section
