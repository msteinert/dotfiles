# If not running interactively, don't do anything
[[ $- != *i* ]] && return

# Set locale
export LANG=en_US.UTF-8

# Configure history
HISTFILE=$HOME/.histfile
HISTSIZE=10000
SAVEHIST=20000

setopt extendedglob
setopt hist_reduce_blanks
setopt hist_verify
setopt histignorealldups
setopt no_case_glob
setopt sharehistory

unsetopt beep nomatch

# Function path
fpath=(
    $HOME/.zsh.d/site-functions
    $fpath
)
autoload -Uz compinit
compinit -u

# Path
BREW_PREFIX=/opt/homebrew

export TERMINFO_DIRS="$BREW_PREFIX/opt/ncurses/share/terminfo:$TERMINFO_DIRS"

path=(
    $HOME/.local/bin
    $HOME/go/bin
    $HOME/.cargo/bin
    $BREW_PREFIX/opt/coreutils/libexec/gnubin
    $BREW_PREFIX/opt/curl/bin
    $path
)
typeset -U path

# Configure GNU ls colors
eval $(dircolors -b $HOME/.dircolors)

# Case insensitive completion for cd etc *N*
zstyle ':completion:*' completer _expand _complete _match
zstyle ':completion:*' completions 0
zstyle ':completion:*' glob 0
zstyle ':completion:*' group-name ''
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' max-errors 1 numeric
zstyle ':completion:*' substitute 0
zstyle :compinstall filename "$HOME/.zshrc"

# Vi command line editing
autoload -U edit-command-line
zle -N edit-command-line
bindkey -v
bindkey '\e[3~' delete-char
bindkey -M vicmd 'v' edit-command-line

# Enable color
autoload -U colors && colors

# Configure the prompt
eval "$(starship init zsh)"

# Source definitions
if [[ -d $HOME/.zsh.d ]]; then
    for i in $HOME/.zsh.d/zsh-*; do
        test -r $i && . $i
    done
    unset i
fi

alias ls="ls --color=auto -F"
alias grep="grep --color=auto"
alias fgrep="fgrep --color=auto"
alias egrep="egrep --color=auto"

# Editor settings
export EDITOR="vim"

# fzf
export FZF_DEFAULT_COMMAND="fd --type file"
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"

# jq
export JQ_COLORS="0;37:0;39:0;39:0;39:0;32:1;39:1;39"

# rg
export RIPGREP_CONFIG_PATH=$HOME/.ripgreprc

# Zoxide
eval "$(zoxide init zsh)"

# Atuin
eval "$(atuin init zsh)"
# Restore vi command mode history navigation; atuin's vim_mode overrides these
# to open its search UI, but we want <esc>k/<esc>j as single-step history nav
bindkey -M vicmd 'k' up-line-or-history
bindkey -M vicmd 'j' down-line-or-history

# cue
[[ -f ~/.local/share/cue/cue.zsh ]] && source ~/.local/share/cue/cue.zsh

# direnv
eval "$(direnv hook zsh)"

# mise
eval "$(mise activate zsh)"
