export GOPRIVATE=git.drwholdings.com

# AI keys (1Password, DRW vault) -- lazy-loaded on first codex invocation
_load_ai_keys() {
  export AZURE_OPENAI_API_KEY="$(op read 'op://DRW/Azure OpenAI/credential' 2>/dev/null)"
  export AZURE_OPENAI_API_ENDPOINT="$(op read 'op://DRW/Azure OpenAI/endpoint' 2>/dev/null)"
  export AZURE_OPENAI_API_VERSION="$(op read 'op://DRW/Azure OpenAI/version' 2>/dev/null)"
  export PORTKEY_API_KEY="$(op read 'op://DRW/Portkey/credential' 2>/dev/null)"
}

codex() {
  [[ -z "$PORTKEY_API_KEY" ]] && _load_ai_keys
  command codex "$@"
}
