{{- if .isWork -}}
export GOPRIVATE=git.drwholdings.com

# 1Password service account (no prompt, auto-unlocks with login keychain)
export OP_SERVICE_ACCOUNT_TOKEN="$(security find-generic-password -a "$USER" -s "op-service-account-token" -w 2>/dev/null)"

# DRW cloud credential config
export AWS_CONFIG_FILE=$HOME/.drw_cca/aws.config
export cred_proc_CERT_PASSPHRASE="$(op read 'op://DRW/DRW Cert Passphrase/credential' 2>/dev/null)"
export cred_proc_CERT_BUNDLE=$HOME/.drw_cca/$USER.pfx
export cred_proc_CACHE=True
export cred_proc_TTL=3600

# AI keys
export AZURE_OPENAI_API_KEY="$(op read 'op://DRW/Azure OpenAI/credential' 2>/dev/null)"
export AZURE_OPENAI_API_ENDPOINT="$(op read 'op://DRW/Azure OpenAI/endpoint' 2>/dev/null)"
export AZURE_OPENAI_API_VERSION="$(op read 'op://DRW/Azure OpenAI/version' 2>/dev/null)"
export PORTKEY_API_KEY="$(op read 'op://DRW/Portkey API Key/credential' 2>/dev/null)"
export ATUIN_AI_API_TOKEN="$PORTKEY_API_KEY"

_ensure_completion cirrus
_ensure_completion ml
_ensure_completion slater
{{- end }}
