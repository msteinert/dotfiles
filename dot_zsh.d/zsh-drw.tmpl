{{- if .isWork -}}
export GOPRIVATE=git.drwholdings.com

# DRW cloud credential config
export AWS_CONFIG_FILE=$HOME/.drw_cca/aws.config
export cred_proc_CERT_PASSPHRASE="$(security find-generic-password -a "$USER" -s "drwcca-cert-passphrase" -w 2>/dev/null)"
export cred_proc_CERT_BUNDLE=$HOME/.drw_cca/$USER.pfx
export cred_proc_CACHE=True
export cred_proc_TTL=3600

# AI keys (from Keychain; populated by setup-keychain.sh)
export PORTKEY_API_KEY="$(security find-generic-password -a "$USER" -s "portkey-api-key" -w 2>/dev/null)"

_ensure_completion cirrus
_ensure_completion ml
_ensure_completion slater
{{- end }}
